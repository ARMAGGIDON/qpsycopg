# Local qpsycopg development configuration.
# Copy this file to .env and replace machine-specific values.

PSYCOPG_IMPL=qt-thread
QPSYCOPG_WORKER_IMPL=binary
PSYCOPG_PG_ROOT=C:\path\to\PostgreSQL\18\pgsql
QPSYCOPG_DSN=postgresql://user:password@host:5432/database

# Optional: use a different env file without changing commands.
# QPSYCOPG_ENV_FILE=.env.local
